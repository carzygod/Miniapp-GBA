{
  "name": "minigba-weapp",
  "version": "0.1.0",
  "private": true,
  "description": "MiniGBA WeChat Mini Program client",
  "scripts": {
    "build:weapp": "node scripts/validate-rom-catalog.mjs catalog.r2.json && taro build --type weapp && node scripts/validate-weapp-output.mjs",
    "dev:weapp": "taro build --type weapp --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --coverage.enabled",
    "test:watch": "vitest",
    "lint": "eslint src --max-warnings 0",
    "validate:catalog": "node scripts/validate-rom-catalog.mjs",
    "generate:catalog": "node scripts/generate-r2-rom-catalog.mjs",
    "audit:prod": "node scripts/audit-production.mjs",
    "report:dependencies": "node scripts/generate-sbom.mjs"
  },
  "dependencies": {
    "@tarojs/components": "4.2.1",
    "@tarojs/helper": "4.2.1",
    "@tarojs/plugin-framework-react": "4.2.1",
    "@tarojs/plugin-platform-weapp": "4.2.1",
    "@tarojs/react": "4.2.1",
    "@tarojs/runtime": "4.2.1",
    "@tarojs/shared": "4.2.1",
    "@tarojs/taro": "4.2.1",
    "fflate": "0.8.2",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.28.5",
    "@babel/preset-react": "7.28.5",
    "@tarojs/cli": "4.2.1",
    "@tarojs/webpack5-runner": "4.2.1",
    "@testing-library/react": "16.3.0",
    "@types/node": "24.1.0",
    "@types/react": "18.3.23",
    "@types/react-dom": "18.3.7",
    "@typescript-eslint/parser": "8.65.0",
    "@vitest/coverage-v8": "4.1.10",
    "babel-preset-taro": "4.2.1",
    "eslint": "9.32.0",
    "miniprogram-ci": "2.1.31",
    "react-refresh": "0.14.2",
    "typescript": "5.9.2",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  }
}
